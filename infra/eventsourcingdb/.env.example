# Copy to .env (git-ignored) and replace the token.
# Generate one: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40
# Recommendation from the vendor: >= 32 chars, upper/lower case letters and digits.
ESDB_API_TOKEN=change-me-to-a-random-32plus-char-token

# Optional
# ESDB_IMAGE_TAG=1.2.0
# ESDB_HOST_PORT=3000
